    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "prisma": "^6.19.3",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
