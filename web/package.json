{
  "name": "my-bmad",
  "version": "0.1.0",
  "description": "A web dashboard to visualize and track BMAD (Breakthrough Method of Agile AI-Driven Development) projects from GitHub repositories.",
  "license": "MIT",
  "author": "Hichem (DevHDI)",
  "homepage": "https://github.com/DevHDI/my-bmad",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevHDI/my-bmad.git"
  },
  "bugs": {
    "url": "https://github.com/DevHDI/my-bmad/issues"
  },
  "keywords": [
    "bmad",
    "dashboard",
    "nextjs",
    "github",
    "agile",
    "project-management",
    "prisma",
    "better-auth"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:create-admin": "tsx scripts/create-admin.ts",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest"
  },
